<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Background: same near-black surface as the adaptive icon background. -->
    <path
        android:fillColor="#101114"
        android:pathData="M0,0h320v180h-320z" />

    <!-- Soft radial glow behind the mark so the triangle never floats on flat black. -->
    <group>
        <path
            android:fillColor="#1A2C42"
            android:pathData="M160,90 m-78,0 a78,78 0 1,0 156,0 a78,78 0 1,0 -156,0" />
    </group>

    <!-- Play mark lifted from icon_foreground.xml: the triangle spans ~(30.5,24.5)-(83.6,83.5),
         so its center is ~(54,54). Scale 2.0 about the origin then translate so that center
         lands on the banner center (160,90): translate = (160 - 54*2, 90 - 54*2) = (52,-18). -->
    <group
        android:scaleX="2.0"
        android:scaleY="2.0"
        android:translateX="52"
        android:translateY="-18">
        <path
            android:fillColor="#9CCAFF"
            android:pathData="M35,24.5 C33,23.35 30.5,24.79 30.5,27.1 L30.5,80.9 C30.5,83.21 33,84.65 35,83.5 L81.6,56.6 C83.6,55.45 83.6,52.55 81.6,51.4 Z" />
    </group>
</vector>
