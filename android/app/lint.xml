<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lint configuration for the Movo Android app module.

  Media3 annotates a broad surface as @UnstableApi. Those annotations are plain
  documentation markers (not @RequiresOptIn), so the Kotlin compiler does not enforce
  an opt-in, but the androidx.annotation.experimental lint detector still raises
  UnsafeOptInUsageError for every call site. Declaring the marker as opted-in here
  keeps the MediaSession / ExoPlayer wiring clean without peppering @OptIn everywhere.
-->
<lint>
    <issue id="UnsafeOptInUsageError">
        <option name="opt-in" value="androidx.media3.common.util.UnstableApi" />
    </issue>

    <!--
      The leanback banner is one fixed-size launcher asset: 320x180 at the density every
      television reports. No phone ever shows it, so the density variants this check asks for
      would be bytes nothing reads.
    -->
    <issue id="IconDensities">
        <ignore regexp="tv_banner" />
    </issue>
</lint>
